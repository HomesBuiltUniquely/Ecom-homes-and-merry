# Copy to .env on the EC2 host (never commit .env)
# cp .env.example .env && nano .env

# Required
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars

# Option A: docker-compose.yml (MySQL on same EC2)
MYSQL_ROOT_PASSWORD=replace-root-password
DB_USERNAME=homes_app
DB_PASSWORD=replace-app-db-password

# Option B: docker-compose.app-only.yml (Amazon RDS)
# DB_URL=jdbc:mysql://your-db.xxxxx.ap-south-1.rds.amazonaws.com:3306/Homes_Merry?useSSL=true&serverTimezone=UTC
# DB_USERNAME=homes_app
# DB_PASSWORD=replace-rds-password
