# Homes-merry — EC2 + Docker + RDS (.env for docker-compose.app-only.yml)
# cp env.rds.example .env && nano .env

# Required — generate if missing: openssl rand -base64 48
JWT_SECRET=

# RDS (Spring expects JDBC URL + these names)
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/Homes_Merry?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# ProLance (optional — used by prolance.api in application.yaml)
PROLANCE_BASE_URL=https://api.prolance.design
PROLANCE_API_KEY=
PROLANCE_USERNAME=
PROLANCE_PASSWORD=
